<!-- Card: launcher corner radius, quiet surface, one soft ember glow, hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="@dimen/wg_radius" /><gradient android:angle="270" android:startColor="@color/wg_top" android:endColor="@color/wg_bottom" /></shape></item>
    <item><shape><corners android:radius="@dimen/wg_radius" /><gradient android:type="radial" android:gradientRadius="220dp" android:centerX="1" android:centerY="0" android:startColor="@color/wg_glow" android:endColor="#00FF2E3B" /></shape></item>
    <item><shape><corners android:radius="@dimen/wg_radius" /><stroke android:width="1dp" android:color="@color/wg_stroke" /></shape></item>
</layer-list>
