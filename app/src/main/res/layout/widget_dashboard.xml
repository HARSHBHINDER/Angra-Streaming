<!-- 4x4: glance + primary action, channel list (iOS list rhythm), then four actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/wg_avatar" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/wg_av_rtmp" android:gravity="center" android:text="A" android:textColor="#FFFFFFFF"
        android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/wg_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:text="Ready" android:textColor="@color/wg_text"
            android:textSize="22sp" android:textStyle="bold" android:letterSpacing="-0.02" />
        <Chronometer android:id="@+id/wg_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/wg_text" android:textSize="22sp" android:textStyle="bold"
            android:letterSpacing="-0.02" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/wg_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" android:text="Your channel · 720p30"
        android:textColor="@color/wg_text2" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/wg_go" android:layout_width="wrap_content" android:layout_height="34dp"
            android:layout_marginStart="8dp" android:background="@drawable/wg_capsule_go" android:gravity="center"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:text="Go Live"
            android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp" android:text="CHANNELS" android:textColor="@color/wg_text2" android:textSize="11sp"
        android:textStyle="bold" android:letterSpacing="0.06" />
    
    <LinearLayout android:id="@+id/wg_ch1" android:layout_width="match_parent" android:layout_height="46dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wg_ch1_av" android:layout_width="30dp" android:layout_height="30dp"
        android:background="@drawable/wg_av_rtmp" android:gravity="center" android:text="A" android:textColor="#FFFFFFFF"
        android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wg_ch1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:singleLine="true" android:ellipsize="end" android:text="Channel"
            android:textColor="@color/wg_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/wg_ch1_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:singleLine="true" android:text="YouTube" android:textColor="@color/wg_text2"
            android:textSize="12sp" />
        <TextView android:id="@+id/wg_ch1_check" android:layout_width="20dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="✓" android:textColor="#FFF2542D" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:id="@+id/wg_sep2" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="42dp" android:background="@drawable/wg_sep" />
    <LinearLayout android:id="@+id/wg_ch2" android:layout_width="match_parent" android:layout_height="46dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wg_ch2_av" android:layout_width="30dp" android:layout_height="30dp"
        android:background="@drawable/wg_av_rtmp" android:gravity="center" android:text="A" android:textColor="#FFFFFFFF"
        android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wg_ch2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:singleLine="true" android:ellipsize="end" android:text="Channel"
            android:textColor="@color/wg_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/wg_ch2_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:singleLine="true" android:text="YouTube" android:textColor="@color/wg_text2"
            android:textSize="12sp" />
        <TextView android:id="@+id/wg_ch2_check" android:layout_width="20dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="✓" android:textColor="#FFF2542D" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:id="@+id/wg_sep3" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="42dp" android:background="@drawable/wg_sep" />
    <LinearLayout android:id="@+id/wg_ch3" android:layout_width="match_parent" android:layout_height="46dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wg_ch3_av" android:layout_width="30dp" android:layout_height="30dp"
        android:background="@drawable/wg_av_rtmp" android:gravity="center" android:text="A" android:textColor="#FFFFFFFF"
        android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wg_ch3_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:singleLine="true" android:ellipsize="end" android:text="Channel"
            android:textColor="@color/wg_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/wg_ch3_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:singleLine="true" android:text="YouTube" android:textColor="@color/wg_text2"
            android:textSize="12sp" />
        <TextView android:id="@+id/wg_ch3_check" android:layout_width="20dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="✓" android:textColor="#FFF2542D" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:id="@+id/wg_sep4" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="42dp" android:background="@drawable/wg_sep" />
    <LinearLayout android:id="@+id/wg_ch4" android:layout_width="match_parent" android:layout_height="46dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wg_ch4_av" android:layout_width="30dp" android:layout_height="30dp"
        android:background="@drawable/wg_av_rtmp" android:gravity="center" android:text="A" android:textColor="#FFFFFFFF"
        android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wg_ch4_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:singleLine="true" android:ellipsize="end" android:text="Channel"
            android:textColor="@color/wg_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/wg_ch4_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:singleLine="true" android:text="YouTube" android:textColor="@color/wg_text2"
            android:textSize="12sp" />
        <TextView android:id="@+id/wg_ch4_check" android:layout_width="20dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="✓" android:textColor="#FFF2542D" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/wg_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Add your first channel in the app to go live from here." android:textColor="@color/wg_text2"
        android:textSize="13sp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal">
        <FrameLayout android:id="@+id/wg_t1" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:background="@drawable/wg_tile_off">
        <ImageView android:id="@+id/wg_t1_icon" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="top|start" android:layout_marginStart="10dp" android:layout_marginTop="10dp"
            android:src="@drawable/ic_play" android:contentDescription="Action" />
        <TextView android:id="@+id/wg_t1_label" android:layout_width="match_parent" android:layout_height="16dp"
            android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:text="Action"
            android:textColor="@color/wg_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    </FrameLayout>
        <FrameLayout android:id="@+id/wg_t2" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/wg_tile_off">
        <ImageView android:id="@+id/wg_t2_icon" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="top|start" android:layout_marginStart="10dp" android:layout_marginTop="10dp"
            android:src="@drawable/ic_play" android:contentDescription="Action" />
        <TextView android:id="@+id/wg_t2_label" android:layout_width="match_parent" android:layout_height="16dp"
            android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:text="Action"
            android:textColor="@color/wg_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    </FrameLayout>
        <FrameLayout android:id="@+id/wg_t3" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/wg_tile_off">
        <ImageView android:id="@+id/wg_t3_icon" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="top|start" android:layout_marginStart="10dp" android:layout_marginTop="10dp"
            android:src="@drawable/ic_play" android:contentDescription="Action" />
        <TextView android:id="@+id/wg_t3_label" android:layout_width="match_parent" android:layout_height="16dp"
            android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:text="Action"
            android:textColor="@color/wg_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    </FrameLayout>
        <FrameLayout android:id="@+id/wg_t4" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/wg_tile_off">
        <ImageView android:id="@+id/wg_t4_icon" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="top|start" android:layout_marginStart="10dp" android:layout_marginTop="10dp"
            android:src="@drawable/ic_play" android:contentDescription="Action" />
        <TextView android:id="@+id/wg_t4_label" android:layout_width="match_parent" android:layout_height="16dp"
            android:layout_gravity="bottom|start" android:layout_marginStart="10dp" android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:text="Action"
            android:textColor="@color/wg_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
